# Read-only accounts for the deduplicated feed (wss://<domena>/feed).
# Each account gets exactly "topic read meshcore/#" - no write access.
#
# Format: account name on one line, its password on the next, blank line
# between accounts. Names may only use letters, digits, "-" and "_".
#
# scripts/create-mosquitto-users.sh regenerates mosquitto/config/passwd and
# mosquitto/config/acl from this file (and the three fixed passwords in
# .env) on every ./scripts/start.sh run. Removing an account here removes
# its login on the next deploy.
#
# Copy this file to feed-readers.env and replace the placeholder passwords.
# feed-readers.env holds real secrets - keep it out of Git, same as .env.

corescope-ro
CHANGE_ME_CORESCOPE

map-ro
CHANGE_ME_MAP
