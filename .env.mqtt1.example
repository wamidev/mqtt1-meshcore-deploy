DEPLOY_MODE=mqtt1-proxy
COMPOSE_PROJECT_NAME=meshcore-mqtt1
PUBLIC_DOMAIN=mqtt1.meshcore.cz
DEDUP_WORKER_IMAGE=ghcr.io/mesh-cz/meshcore-dedup-worker:latest
MESHCORE_BROKER_IMAGE=ghcr.io/mesh-cz/meshcore-mqtt-broker:latest
MONITOR_IMAGE=ghcr.io/mesh-cz/meshcore-mqtt-monitor:latest
AUTH_EXPECTED_AUDIENCE=mqtt1.meshcore.cz
PUBLIC_BROKER_READER_PASSWORD=CHANGE_ME_MQTT1_READER
ABUSE_ENFORCEMENT_ENABLED=true

MQTT_SOURCE_1_URL=wss://mqtt1.meshcore.cz/mqtt
MQTT_SOURCE_1_USERNAME=dedup-reader
MQTT_SOURCE_1_PASSWORD=CHANGE_ME_MQTT1_READER
MQTT_SOURCE_2_URL=wss://mqtt2.meshcore.website/mqtt
MQTT_SOURCE_2_USERNAME=dedup-reader
MQTT_SOURCE_2_PASSWORD=CHANGE_ME_MQTT2_READER

MQTT_TARGET_URL=ws://feed-broker:9001
MQTT_TARGET_USERNAME=dedup-writer
MQTT_TARGET_PASSWORD=CHANGE_ME_MQTT1_LOCAL_WRITER
MQTT_LOCAL_DEDUP_READER_PASSWORD=CHANGE_ME_MQTT1_LOCAL_READER

MQTT_INPUT_TOPIC=meshcore/#
MQTT_OUTPUT_PREFIX=meshcore
DEDUP_TTL_SECONDS=600
DEDUP_KEY_MODE=topic_raw
# Optional temporary diagnostics; use only the observer public key, without region/topic.
DEDUP_DIAGNOSTIC_PUBLIC_KEY=
MQTT_QOS=1
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_CLIENT_ID_PREFIX=meshcore-dedup-mqtt1
MONITOR_EVENTS_ENABLED=true
MONITOR_TOPIC_PREFIX=meshcore-monitor
MONITOR_OBSERVER_IP_SOURCE=source1
MONITOR_RETENTION_DAYS=30
MONITOR_ACTIVE_WINDOW_SECONDS=180

FEED_HEALTH_PASSWORD=CHANGE_ME_MQTT1_LOCAL_READER
DEDUP_WRITER_PASSWORD=CHANGE_ME_MQTT1_LOCAL_WRITER
CORESCOPE_RO_PASSWORD=CHANGE_ME_CORESCOPE
MAP_RO_PASSWORD=CHANGE_ME_MAP
MONITOR_MQTT_PASSWORD=CHANGE_ME_MONITOR
MONITOR_RO_PASSWORD=CHANGE_ME_MONITOR
