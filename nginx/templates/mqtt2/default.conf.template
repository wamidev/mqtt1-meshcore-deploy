map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name ${PUBLIC_DOMAIN};
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Do not serve this virtual host under an unexpected Host header.
    if ($host != ${PUBLIC_DOMAIN}) {
        return 404 "Not found\n";
    }

    location = /health {
        access_log off;
        default_type text/plain;
        charset utf-8;
        return 200 "ok\n";
    }

    location /mqtt {
        default_type text/plain;
        charset utf-8;
        if ($http_upgrade = '') {
            return 426 "WebSocket upgrade required\n";
        }
        proxy_pass http://public-broker:8883;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    # Public read-only access to the deduplicated feed. Authorization is
    # enforced by the internal Mosquitto ACL (corescope-ro / map-ro).
    location /feed {
        default_type text/plain;
        charset utf-8;
        if ($http_upgrade = '') {
            return 426 "WebSocket upgrade required\n";
        }
        proxy_pass http://feed-proxy:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-MeshCore-Client-IP $http_cf_connecting_ip;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    # Browsers receive the information page. The MeshCore Home Assistant
    # integration continues to use the WebSocket root path.
    location = / {
        error_page 418 = /site/index.html;
        if ($http_upgrade = '') {
            return 418;
        }
        proxy_pass http://public-broker:8883;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    location = /site {
        return 301 /site/;
    }

    location = /robots.txt {
        root /usr/share/nginx/html;
        try_files /site/robots.txt =404;
        default_type text/plain;
        charset utf-8;
    }

    location = /sitemap.xml {
        root /usr/share/nginx/html;
        try_files /site/sitemap.xml =404;
        default_type application/xml;
        charset utf-8;
    }

    location = /llms.txt {
        root /usr/share/nginx/html;
        try_files /site/llms.txt =404;
        default_type text/plain;
        charset utf-8;
    }

    location /site/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /site/index.html;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-6kE/1owddjuWFFKyMukRdnrhD8n6cleiPPxHffqZVg8='; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    }

    location / {
        default_type text/plain;
        charset utf-8;
        return 404 "Not found\n";
    }
}

# Administrative monitoring is published on a separate hostname. Cloudflare
# Access must protect this hostname before it is added to the tunnel.
server {
    listen 80;
    server_name ${MONITOR_DOMAIN};
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;

    if ($host != ${MONITOR_DOMAIN}) {
        return 404 "Not found\n";
    }

    location / {
        proxy_pass http://monitor:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        proxy_hide_header Server;
    }
}
