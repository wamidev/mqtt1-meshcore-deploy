map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name ${PUBLIC_DOMAIN};
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Do not serve this virtual host under an unexpected Host header.
    if ($host != ${PUBLIC_DOMAIN}) {
        return 404 "Not found\n";
    }

    location = /health {
        access_log off;
        default_type text/plain;
        charset utf-8;
        return 200 "ok\n";
    }

    location /mqtt {
        default_type text/plain;
        charset utf-8;
        if ($http_upgrade = '') {
            return 426 "WebSocket upgrade required\n";
        }
        proxy_pass http://public-broker:8883;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    # Public read-only access to the deduplicated feed. Authorization is
    # enforced by the internal Mosquitto ACL (corescope-ro / map-ro).
    location /feed {
        default_type text/plain;
        charset utf-8;
        if ($http_upgrade = '') {
            return 426 "WebSocket upgrade required\n";
        }
        proxy_pass http://feed-broker:9001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    # The MeshCore Home Assistant integration uses the WebSocket root path.
    location = / {
        default_type text/plain;
        charset utf-8;
        if ($http_upgrade = '') {
            return 200 "MeshCore CZ MQTT2 endpoint\n";
        }
        proxy_pass http://public-broker:8883;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }

    location / {
        default_type text/plain;
        charset utf-8;
        return 404 "Not found\n";
    }
}

# Administrative monitoring is published on a separate hostname. Cloudflare
# Access must protect this hostname before it is added to the tunnel.
server {
    listen 80;
    server_name ${MONITOR_DOMAIN};
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;

    if ($host != ${MONITOR_DOMAIN}) {
        return 404 "Not found\n";
    }

    location / {
        proxy_pass http://monitor:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        proxy_hide_header Server;
    }
}
